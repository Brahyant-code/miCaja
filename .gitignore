# Dependencias de Composer
/vendor/

# Configuración local con credenciales (NO versionar)
/config/database.php

# Logs
*.log

# Archivos de entorno / locales
.env
.DS_Store
Thumbs.db

# Frontend (Node / Vite)
/node_modules/

# Artefactos del build de Vite (se regeneran con "npm run build")
/public/index.html
/public/assets/

# Imágenes subidas de productos (no versionar el contenido, sí la carpeta)
/public/uploads/productos/*
!/public/uploads/productos/.gitkeep
